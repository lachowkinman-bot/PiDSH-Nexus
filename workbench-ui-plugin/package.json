{
  "name": "@workbench/client-ui",
  "description": "PiDSH Nexus 工作台插件：战略总看板、13 业务域、78 条 V2 工作流、LLM/审批/交付/复盘闭环，挂载于 DSH web 壳内。",
  "version": "4.0.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client-v4.js"
  },
  "dsh": {
    "engines": { "dsh": ">=0.1.7-rc.2" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.2",
    "react": "^18.2.0"
  },
  "files": ["lib/**/*.js", "lib/**/*.cjs", "lib/**/*.mjs", "cordis.patch.yml", "README.md"],
  "license": "Apache-2.0"
}
