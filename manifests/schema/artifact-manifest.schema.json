{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pids-nexus:schema:artifact-manifest:v1",
  "title": "PiDSH Nexus ArtifactManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "instance_id", "workflow_id", "created_at", "artifacts"],
  "properties": {
    "schema": { "const": "pids-nexus/artifact-manifest/v1" },
    "instance_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "file", "bytes", "sha256"],
        "properties": {
          "format": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
