{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pids-nexus:schema:workflow-definition:v2",
  "title": "PiDSH Nexus WorkflowDefinitionV2",
  "type": "object",
  "additionalProperties": true,
  "required": ["workflow_id", "domain", "kind", "description", "skill", "trigger", "deliverable", "stages"],
  "properties": {
    "workflow_id": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "trigger": { "type": "object" },
    "deliverable": { "type": "object" },
    "approval": { "type": ["object", "null"] },
    "hitl_nodes": { "type": "array", "items": { "type": "string" } },
    "dual": { "type": "boolean" },
    "stages": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "urn:pids-nexus:schema:stage-run:v2" }
    },
    "data_contract": { "type": "object" },
    "business_rules": { "type": "array", "items": { "type": "object" } },
    "cross_domain_effects": { "type": "array", "items": { "type": "object" } }
  }
}
