{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pids-nexus:schema:strategy-objective:v1",
  "title": "PiDSH Nexus StrategyObjective",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "owner", "baseline", "target", "unit", "period", "key_results", "domains"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "baseline": { "type": "number" },
    "target": { "type": "number" },
    "unit": { "type": "string" },
    "period": { "type": "string", "pattern": "^\\d{4}-Q[1-4]$" },
    "key_results": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "domains": { "type": "object", "minProperties": 13 }
  }
}
