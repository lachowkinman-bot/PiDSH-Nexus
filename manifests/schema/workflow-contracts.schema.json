{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pids-nexus:schema:workflow-contracts:v1",
  "title": "PiDSH Nexus Workflow Contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "domain", "source_standards", "contracts"],
  "properties": {
    "schema": { "const": "pids-nexus/workflow-contracts/v1" },
    "domain": { "type": "string", "minLength": 1 },
    "source_standards": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "contracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
            "required": ["workflow_id", "module_id", "work_item_id", "input", "output", "acceptance", "business_rules", "cross_domain_effects", "stage_contracts", "stages"],
        "properties": {
          "workflow_id": { "type": "string", "minLength": 1 },
          "module_id": { "type": "string", "minLength": 1 },
          "work_item_id": { "type": "string", "minLength": 1 },
          "input": {
            "type": "object",
            "required": ["$schema", "$id", "type", "additionalProperties", "required", "properties"],
            "properties": {
              "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
              "$id": { "type": "string", "minLength": 1 },
              "type": { "const": "object" },
              "additionalProperties": { "const": false },
              "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "properties": { "type": "object" }
            }
          },
          "output": {
            "type": "object",
            "required": ["$schema", "$id", "type", "additionalProperties", "required", "properties"],
            "properties": {
              "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
              "$id": { "type": "string", "minLength": 1 },
              "type": { "const": "object" },
              "additionalProperties": { "const": false },
              "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "properties": { "type": "object" }
            }
          },
          "acceptance": { "type": "string", "minLength": 1 },
          "business_rules": { "type": "array", "items": { "type": "object" } },
          "cross_domain_effects": { "type": "array", "items": { "type": "object" } },
          "stage_contracts": {
            "type": "object",
            "minProperties": 8,
            "additionalProperties": {
              "type": "object",
              "required": ["input", "output"],
              "properties": {
                "input": { "type": "object" },
                "output": { "type": "object" }
              }
            }
          },
          "stages": { "type": "array", "minItems": 7, "items": { "type": "object" } }
        }
      }
    }
  }
}
